; Burns — original family card game.
config_version=5

[application]
config/name="Burns"
config/icon="res://assets/art/icon.svg"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A little solitaire. A little rivalry. A table for everyone."

[display]
window/size/viewport_width=480
window/size/viewport_height=800
window/size/window_width_override=1120
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.075, 0.085, 1)
